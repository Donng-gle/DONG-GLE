# client-front/.env 로 복사해서 실제 값 채우기. .env는 절대 커밋하지 않음.
# EXPO_PUBLIC_ 접두사가 붙은 변수는 Expo가 빌드 시 자동으로 process.env에 주입함.

EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# 선택. 비워두면 플랫폼별 기본값(에뮬레이터/시뮬레이터 기준) 사용 (api/config.ts 참고).
# 실기기 테스트 시 같은 Wi-Fi의 Mac LAN IP(예: http://192.168.0.10:8080) 또는
# 배포된 백엔드(예: https://dong-gle.onrender.com)로 덮어써야 함
EXPO_PUBLIC_API_BASE_URL=
