# server-back/.env 로 복사해서 실제 값 채우기. .env는 절대 커밋하지 않음.

# Supabase 프로젝트 설정 > Database > Connection string(URI)에서 확인 가능.
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres?stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 2026-08-26 결정: 구글은 code 교환이 아니라 ID 토큰 검증 방식으로 전환 (decision-log 참고).
# GOOGLE_CLIENT_ID는 Web 애플리케이션 OAuth 클라이언트("서버 클라이언트 ID") ID를 audience 검증용으로 사용.
# GOOGLE_CLIENT_SECRET/GOOGLE_REDIRECT_URI는 이제 실제로 안 쓰이지만(네이티브 로그인엔 리다이렉트 자체가 없음),
# Web 애플리케이션 클라이언트 자체를 만들 때 콘솔이 요구해서 등록해둔 값이라 필드는 유지
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AWS S3 (이미지 업로드용). IAM 사용자 dongle-s3-uploader의 액세스 키 사용
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=donggle-uploads

# Google Places 사진 프록시(/images/proxy)용. 데이터 파트 .env의 GOOGLE_MAPS_API_KEY와 동일한 키 사용 가능
GOOGLE_MAPS_API_KEY=
