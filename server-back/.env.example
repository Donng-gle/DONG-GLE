# server-back/.env 로 복사해서 실제 값 채우기. .env는 절대 커밋하지 않음.

# Supabase 프로젝트 설정 > Database > Connection string(URI)에서 확인 가능.
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres?stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=

# 2026-08-27: 카카오 콘솔이 커스텀 스킴(dongle://) 리다이렉트를 거부해서, 카카오 Redirect URI엔
# 이 백엔드의 중계 엔드포인트(GET /auth/kakao/callback)를 등록해야 함 — decision-log 참고
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://dong-gle.onrender.com/auth/kakao/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AWS S3 (이미지 업로드용). IAM 사용자 dongle-s3-uploader의 액세스 키 사용
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=donggle-uploads

# Google Places 사진 프록시(/images/proxy)용. 데이터 파트 .env의 GOOGLE_MAPS_API_KEY와 동일한 키 사용 가능
GOOGLE_MAPS_API_KEY=
