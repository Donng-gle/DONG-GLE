# LocgoHubTarService1 (기초지자체 중심 관광지)
# https://www.data.go.kr/data/15128559/openapi.do
# endpoint: https://apis.data.go.kr/B551011/LocgoHubTarService1
LOCGO_HUB_SERVICE_KEY=

# Google Maps Platform API key
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# OpenAI API (LLM 블라인드 평가 실험)
OPENAI_API_KEY=

# true면 OpenAI 호출 없이 mock 평가기 사용
REVIEW_RANGE_USE_MOCK=true

# semantic_vector (GPT Vision + Qdrant)
OPENAI_MODEL=gpt-4.1-mini
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=place_semantic_vectors
SEMANTIC_PROMPT_VERSION=semantic-image-v1
SEMANTIC_TAG_SCHEMA_VERSION=tourism-semantic-tags-v1
SEMANTIC_BATCH_CONCURRENCY=3
