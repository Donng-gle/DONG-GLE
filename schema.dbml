// 동글 DB 스키마 (PostgreSQL)
// 탈퇴 처리: Hard delete + CASCADE (MVP), 추후 soft delete로 전환 예정

Enum place_category {
  관광지
  식당
  카페
  액티비티
  문화공간
  축제행사
}

Table place {
  id               bigint           [pk, increment]
  content_id       varchar(20)      [unique, not null, note: 'TourAPI contentid']
  content_type_id  smallint         [not null, note: '12/14/15/28/38/39']
  category         place_category   [not null, note: '동글 내부 카테고리']
  name             varchar(200)     [not null, note: 'title']
  addr1            varchar(100)
  addr2            varchar(100)
  lat              double           [note: 'mapy']
  lng              double           [note: 'mapx']
  tel              varchar(50)      [note: '행사축제(15)는 100% 채워짐, 나머지 타입은 대부분 없음']
  main_image_url   text             [note: 'firstimage']
  overview         text             [note: 'detailCommon2.overview']
  homepage         text             [note: '적재 시 URL만 파싱해서 저장']
  lcls_systm1      varchar(10)      [note: '신분류체계 1 (category 매핑 참고용)']
  lcls_systm2      varchar(10)
  lcls_systm3      varchar(10)
  event_start_date date             [note: '행사축제(15)만. searchFestival2 수집']
  event_end_date   date
  visit_log_count  int              [not null, default: 0, note: '서비스 로직에서 관리']
  hidden_score     float            [note: '숨은명소 점수, 데이터 파트가 산출하여 적재. null = 미산출']
  synced_at        timestamp
}

Table place_image {
  id         bigint [pk, increment]
  place_id   bigint [not null, ref: > place.id]
  img_url    text   [not null, note: 'originimgurl (== smallimageurl)']
  sort_order int    [not null, default: 0, note: '0 이상']

  indexes {
    (place_id, img_url) [unique]
  }
}

Table place_emotion_tag {
  id       bigint      [pk, increment]
  place_id bigint      [not null, ref: > place.id]
  tag      varchar(50) [not null]
  count    int         [not null, default: 1, note: '1 이상, 상위 태그 선정에 사용']

  indexes {
    (place_id, tag) [unique]
  }
}

Table user {
  id                bigint       [pk, increment]
  user_id           varchar(50)  [not null, unique, note: '서비스 사용자 ID']
  nickname          varchar(50)  [not null]
  email             varchar(200)
  oauth_provider    varchar(20)  [not null, note: "CHECK: 'kakao' | 'google'"]
  oauth_id          varchar(100) [not null]
  profile_image_url text
  has_onboarded     boolean      [not null, default: false, note: '앱 재시작 시 온보딩 완료 여부 판단']
  created_at        timestamp    [not null, default: `now()`]
  updated_at        timestamp    [not null, default: `now()`, note: 'UPDATE 시 자동 갱신']

  indexes {
    (oauth_provider, oauth_id) [unique]
  }
}

Table user_preference {
  id         bigint      [pk, increment]
  user_id    bigint      [not null, ref: > user.id]
  tag        varchar(50) [not null]
  score      float       [not null, note: '스와이프 누적 점수, 상위 2-3개 태그를 대표 취향으로 사용']
  updated_at timestamp   [not null, default: `now()`, note: 'UPDATE 시 자동 갱신']

  indexes {
    (user_id, tag) [unique]
  }
}

Table place_like {
  id         bigint    [pk, increment]
  user_id    bigint    [not null, ref: > user.id]
  place_id   bigint    [not null, ref: > place.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, place_id) [unique]
  }
}

Table visit_log {
  id         bigint       [pk, increment]
  user_id    bigint       [not null, ref: > user.id]
  place_id   bigint       [not null, ref: > place.id]
  photo_url  text
  one_line   varchar(100)
  is_public  boolean      [not null, default: true, note: '유사 사용자 탐색(GET /explore/similar-logs)에서 공개 기록만 노출']
  visited_at timestamp    [not null, default: `now()`]
}

// 온보딩 카드 (AI 파트가 사전 분석하여 적재. 온보딩 런타임에 AI 호출 없음)
// place_id: nullable — 특정 장소에 종속되지 않는 분위기 카드 허용
// 태그별 최소 4장, is_seed=true 카드 7장(태그별 대표 1장씩) 필수
Table onboarding_card {
  id          bigint    [pk, increment]
  place_id    bigint    [ref: > place.id, note: '장소 기반 카드, nullable. 장소 삭제 시 SET NULL']
  image_url   text      [not null]
  is_seed     boolean   [not null, default: false, note: '시드 카드 여부']
  relaxing    float     [not null, default: 0]
  lively      float     [not null, default: 0]
  romantic    float     [not null, default: 0]
  local       float     [not null, default: 0]
  photogenic  float     [not null, default: 0]
  traditional float     [not null, default: 0]
  modern      float     [not null, default: 0]
  created_at  timestamp [not null, default: `now()`]

  indexes {
    (is_seed)
    (place_id)
  }
}

Table log_emotion_tag {
  id           bigint      [pk, increment]
  visit_log_id bigint      [not null, ref: > visit_log.id]
  tag          varchar(50) [not null]

  indexes {
    (visit_log_id, tag) [unique]
  }
}

Table course {
  id          bigint       [pk, increment]
  user_id     bigint       [not null, ref: > user.id]
  title       varchar(200) [not null]
  source      varchar(20)  [not null, note: "CHECK: 'ai' | 'ai_edited' | 'user'"]
  travel_date date
  created_at  timestamp    [not null, default: `now()`]
  updated_at  timestamp    [not null, default: `now()`, note: 'UPDATE 시 자동 갱신']
}

Table course_place {
  id           bigint [pk, increment]
  course_id    bigint [not null, ref: > course.id]
  place_id     bigint [not null, ref: > place.id]
  visit_order  int    [not null, note: '1 이상']
  planned_time time

  indexes {
    (course_id, visit_order) [unique]
    (place_id)
  }
}
