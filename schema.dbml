// 동글 DB 스키마 (PostgreSQL)
// 탈퇴 처리: Hard delete + CASCADE (MVP), 추후 soft delete로 전환 예정

Enum place_category {
  관광지
  식당
  카페
  액티비티
  문화공간
  축제행사
}

Table place {
  id               bigint           [pk, increment]
  content_id       varchar(20)      [unique, not null, note: 'TourAPI contentid']
  content_type_id  smallint         [not null, note: '12/14/15/28/38/39']
  category         place_category   [not null, note: '동글 내부 카테고리']
  name             varchar(200)     [not null, note: 'title']
  addr1            varchar(100)
  addr2            varchar(100)
  lat              double           [note: 'mapy']
  lng              double           [note: 'mapx']
  tel              varchar(50)      [note: '행사축제(15)는 100% 채워짐, 나머지 타입은 대부분 없음']
  main_image_url   text             [note: 'firstimage']
  overview         text             [note: 'detailCommon2.overview']
  homepage         text             [note: '적재 시 URL만 파싱해서 저장']
  lcls_systm1      varchar(10)      [note: '신분류체계 1 (category 매핑 참고용)']
  lcls_systm2      varchar(10)
  lcls_systm3      varchar(10)
  event_start_date date             [note: '행사축제(15)만. searchFestival2 수집']
  event_end_date   date
  visit_log_count  int              [not null, default: 0, note: '서비스 로직에서 관리']
  hidden_score     float            [note: '숨은명소 점수, 데이터 파트가 산출하여 적재. null = 미산출']
  synced_at        timestamp
}

Table place_image {
  id         bigint [pk, increment]
  place_id   bigint [not null, ref: > place.id]
  img_url    text   [not null, note: 'originimgurl (== smallimageurl)']
  sort_order int    [not null, default: 0, note: '0 이상']

  indexes {
    (place_id, img_url) [unique]
  }
}

Table place_hours {
  id         bigint   [pk, increment]
  place_id   bigint   [not null, ref: > place.id]
  open_day   smallint [not null, note: '0=일요일 ~ 6=토요일 (Google 기준)']
  open_time  time     [not null]
  close_day  smallint [note: '자정 넘어가는 영업 표현용']
  close_time time     [note: 'close_day/close_time null이면 해당 open_day 24시간 영업']

  Note: 'Google Places opening_hours.periods 기준. 브레이크타임 데이터는 소스에 사실상 없어 미반영'

  indexes {
    (place_id, open_day, open_time) [unique]
  }
}

Table place_semantic_vector {
  place_id                 bigint      [pk, ref: > place.id]
  representative_image_url text        [not null]
  analysis_image_urls      json        [not null, default: '[]', note: 'JSONB']
  analysis_image_count     int         [not null]
  detail_scores            json        [not null, note: '35개 세부 태그 점수, JSONB']
  major_scores             json        [not null, note: '7개 대분류 태그 점수, JSONB. docs/ssot.md 감성태그셋 참고']
  summary                  text
  model_name               text        [not null]
  prompt_version           text        [not null]
  tag_schema_version       text        [not null]
  qdrant_point_id          text        [not null, note: 'Qdrant place_semantic_vectors 컬렉션의 벡터 검색용 point id']
  analyzed_at              timestamptz [not null, default: `now()`]

  Note: '장소별 VLM(GPT Vision) semantic 분석 raw score. 장소당 최신 분석 결과 1행만 유지. log_emotion_tag(방문 로그 누적, 조회 시점에 직접 집계)와는 별개 신호. 데이터 파트 배치 스크립트(data/pipeline/semantic_vector_sync.py)로만 적재됨, 백엔드는 읽기 전용'
}

// place_emotion_tag 테이블은 2026-09-02 제거됨 — 장소별 방문 로그 누적 감성 태그는 이제 저장된
// 카운터 없이 log_emotion_tag를 조회 시점에 직접 집계함 (decision-log 참고)

Table user {
  id                bigint       [pk, increment]
  user_id           varchar(50)  [not null, unique, note: '서비스 사용자 ID']
  nickname          varchar(50)  [not null]
  email             varchar(200)
  oauth_provider    varchar(20)  [not null, note: "CHECK: 'kakao' | 'google'"]
  oauth_id          varchar(100) [not null]
  profile_image_url text
  has_onboarded     boolean      [not null, default: false, note: '앱 재시작 시 온보딩 완료 여부 판단']
  created_at        timestamp    [not null, default: `now()`]
  updated_at        timestamp    [not null, default: `now()`, note: 'UPDATE 시 자동 갱신']

  indexes {
    (oauth_provider, oauth_id) [unique]
  }
}

Table refresh_token {
  id         bigint       [pk, increment]
  user_id    bigint       [not null, ref: > user.id]
  token      varchar(500) [not null, unique]
  expires_at timestamp    [not null]
  created_at timestamp    [not null, default: `now()`]

  Note: '로그아웃 시 무효화 처리용 서버 측 화이트리스트'
}

Table user_preference {
  id         bigint      [pk, increment]
  user_id    bigint      [not null, ref: > user.id]
  tag        varchar(50) [not null]
  score      float       [not null, note: '스와이프 누적 점수, 상위 2-3개 태그를 대표 취향으로 사용']
  updated_at timestamp   [not null, default: `now()`, note: 'UPDATE 시 자동 갱신']

  indexes {
    (user_id, tag) [unique]
  }
}

Table place_like {
  id         bigint    [pk, increment]
  user_id    bigint    [not null, ref: > user.id]
  place_id   bigint    [not null, ref: > place.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, place_id) [unique]
  }
}

Table visit_log {
  id         bigint       [pk, increment]
  user_id    bigint       [not null, ref: > user.id]
  place_id   bigint       [not null, ref: > place.id]
  title      varchar(50)  [note: '기록 제목. 2026-09-05 추가(메인 페이지-나의 일지-기록하기), decision-log 참고']
  one_line   varchar(100)
  weather    varchar(20)  [note: '자유 입력 텍스트(선택지 코드 없음). 2026-09-05 추가, decision-log 참고']
  rating     smallint     [note: '별점(1~5), 선택 입력. 2026-09-05 추가, decision-log 참고']
  is_public  boolean      [not null, default: true, note: '유사 사용자 탐색(GET /explore/similar-logs)에서 공개 기록만 노출']
  visited_at timestamp    [not null, default: `now()`]
}

// 방문 기록 사진 (여러 장). 이전엔 visit_log.photo_url 단일 컬럼이었음(사진 1장만 가능).
// place_image와 동일한 패턴(부모 테이블 + sort_order)으로 확장 (2026-09-06 결정, decision-log 참고)
Table visit_log_photo {
  id           bigint [pk, increment]
  visit_log_id bigint [not null, ref: > visit_log.id]
  photo_url    text   [not null]
  sort_order   int    [not null, default: 0, note: '0 이상']
}

// 온보딩 카드 (AI 파트가 사전 분석하여 적재. 온보딩 런타임에 AI 호출 없음)
// place_id: nullable — 특정 장소에 종속되지 않는 분위기 카드 허용
// 태그별 최소 4장, is_seed=true 카드 7장(태그별 대표 1장씩) 필수
Table onboarding_card {
  id          bigint    [pk, increment]
  place_id    bigint    [ref: > place.id, note: '장소 기반 카드, nullable. 장소 삭제 시 SET NULL']
  image_url   text      [not null]
  is_seed     boolean   [not null, default: false, note: '시드 카드 여부']
  relaxing    float     [not null, default: 0]
  lively      float     [not null, default: 0]
  romantic    float     [not null, default: 0]
  local       float     [not null, default: 0]
  photogenic  float     [not null, default: 0]
  traditional float     [not null, default: 0]
  modern      float     [not null, default: 0]
  created_at  timestamp [not null, default: `now()`]

  indexes {
    (is_seed)
    (place_id)
  }
}

// 온보딩 스와이프 이력 (진행 상태 복원 + 수렴 판정용. 최근 3장 변화량 계산에 사용)
// onboarding/reset 시 유저의 이 이력 전체를 삭제하고 재시작
Table onboarding_swipe_log {
  id            bigint      [pk, increment]
  user_id       bigint      [not null, ref: > user.id]
  card_id       bigint      [not null, ref: > onboarding_card.id]
  action        varchar(10) [not null, note: "CHECK: 'like' | 'dislike'"]
  change_amount float       [not null, note: '이번 스와이프로 인한 벡터 변화량 Σ|after-before|/7']
  created_at    timestamp   [not null, default: `now()`]

  indexes {
    (user_id, card_id) [unique]
    (user_id, created_at)
  }
}

Table log_emotion_tag {
  id           bigint           [pk, increment]
  visit_log_id bigint           [not null, ref: > visit_log.id]
  tag          varchar(50)      [not null]
  score        double precision [not null, note: 'AI 확신도(0.0~1.0). 실제 Supabase엔 이미 있었는데 문서 반영이 안 돼 있던 걸 뒤늦게 맞춤(2026-09-03)']

  Note: '방문 기록 사진 AI 분석으로 자동 부여. 장소의 상위 태그(place.top_tags)는 이 테이블을 SUM(score) 기준으로 조회 시점에 직접 집계해서 계산함(별도 카운터 테이블 없음, 2026-09-02 결정 / score 가중치는 2026-09-03 추가)'

  indexes {
    (visit_log_id, tag) [unique]
  }
}

Table course {
  id          bigint       [pk, increment]
  user_id     bigint       [not null, ref: > user.id]
  title       varchar(200) [not null]
  source      varchar(20)  [not null, note: "CHECK: 'ai' | 'ai_edited' | 'user'"]
  travel_date date
  end_date    date         [note: '여러 날 범위 지원. "직접 코스 만들기"에서만 입력받음(2026-09-06 결정, decision-log 참고)']
  transport   varchar(10)  [note: "CHECK: 'car' | 'walk' | 'public', 구글맵 경로 재계산용. nullable(과거 데이터/미입력 허용)"]
  created_at  timestamp    [not null, default: `now()`]
  updated_at  timestamp    [not null, default: `now()`, note: 'UPDATE 시 자동 갱신']
}

Table course_place {
  id           bigint [pk, increment]
  course_id    bigint [not null, ref: > course.id]
  place_id     bigint [not null, ref: > place.id]
  visit_order  int    [not null, note: '1 이상']
  planned_time time

  indexes {
    (course_id, visit_order) [unique]
    (place_id)
  }
}

// 알림 설정 (유저당 1행). push_enabled=false면 나머지 값과 무관하게 알림 미발송
Table notification_setting {
  id              bigint    [pk, increment]
  user_id         bigint    [not null, unique, ref: > user.id]
  push_enabled    boolean   [not null, default: false]
  event_alert     boolean   [not null, default: true]
  course_reminder boolean   [not null, default: true]
  updated_at      timestamp [not null, default: `now()`, note: 'UPDATE 시 자동 갱신']
}

// FCM 디바이스 토큰. 플랫폼별 최신 토큰만 유지(덮어씀)
Table device_token {
  id         bigint       [pk, increment]
  user_id    bigint       [not null, ref: > user.id]
  platform   varchar(10)  [not null, note: "CHECK: 'ios' | 'android'"]
  fcm_token  varchar(500) [not null]
  updated_at timestamp    [not null, default: `now()`]

  indexes {
    (user_id, platform) [unique]
  }
}

// 스와이프 세션 (일정짜기 화면. POST /swipe/candidates 발급, 24시간 유효)
// id는 애플리케이션에서 'swipe_session_' + UUID로 생성 (세션 토큰 성격, 순번 노출 방지)
Table swipe_session {
  id          varchar(50) [pk]
  user_id     bigint      [not null, ref: > user.id]
  travel_date date        [not null]
  transport   varchar(10) [not null, note: "CHECK: 'car' | 'walk' | 'public'"]
  expires_at  timestamp   [not null]
  created_at  timestamp   [not null, default: `now()`]
}

// 스와이프 세션의 후보 카드 (발급 시점 순서 고정). action이 NULL이면 아직 스와이프 안 한 잔여 후보
Table swipe_session_candidate {
  id         bigint      [pk, increment]
  session_id varchar(50) [not null, ref: > swipe_session.id]
  place_id   bigint      [not null, ref: > place.id]
  sort_order int         [not null]
  action     varchar(10) [note: "CHECK: 'like' | 'skip' | 'must', NULL = 미스와이프"]
  swiped_at  timestamp

  indexes {
    (session_id, place_id) [unique]
    (session_id, sort_order)
  }
}
